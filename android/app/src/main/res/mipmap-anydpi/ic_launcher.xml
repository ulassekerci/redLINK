<?xml version="1.0" encoding="utf-8"?>
<!-- The React Native app's Android icon, from the legacy-stack tag. The image
     is inset to the 72dp the launcher shows of the 108dp layer, so the whole
     of it is seen and only the mask's corners are cut. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="16.667%" />
    </foreground>
</adaptive-icon>
